diff --git a/source/isaaclab/isaaclab/utils/noise/noise_model.py b/source/isaaclab/isaaclab/utils/noise/noise_model.py
index 78b93c9f099..da71ba4c1e4 100644
--- a/source/isaaclab/isaaclab/utils/noise/noise_model.py
+++ b/source/isaaclab/isaaclab/utils/noise/noise_model.py
@@ -99,6 +99,41 @@ def gaussian_noise(data: torch.Tensor, cfg: noise_cfg.GaussianNoiseCfg) -> torch
         raise ValueError(f"Unknown operation in noise: {cfg.operation}")
 
 
+
+def d435i_depth_noise(data: torch.Tensor, cfg: noise_cfg.D435iDepthNoiseCfg) -> torch.Tensor:
+    """수식 D_noisy = M_hole * [D_clean + N(0, sigma_total)] 구현 (80x60 해상도)."""
+    
+    # 1. 거리 기반 노이즈 계산 (z^2 / (f*B) * subpixel)
+    # 저해상도에서는 f_pixel이 작아지므로 분모가 작아져 노이즈가 상대적으로 커 보일 수 있음
+    sigma_dist = (data**2) / (cfg.f_pixel * cfg.baseline) * cfg.subpixel
+    
+    # 2. 에지 노이즈 (Edge Scattering)
+    # 80x60 해상도에서는 픽셀 간격이 넓으므로 차분값이 크게 튈 수 있음
+    diff_x = torch.abs(data - torch.roll(data, shifts=1, dims=-1))
+    diff_y = torch.abs(data - torch.roll(data, shifts=1, dims=-2))
+    edge_map = torch.max(diff_x, diff_y)
+    
+    # 저해상도 특성을 고려한 에지 노이즈 합산
+    sigma_edge = edge_map * cfg.edge_std_scale
+    sigma_total = torch.sqrt(sigma_dist**2 + sigma_edge**2)
+    
+    # 가우시안 노이즈 추가
+    noise = torch.randn_like(data) * sigma_total
+    data_noisy = data + noise
+    
+    # 3. Holes (M_hole) - 데이터 결손 마스크
+    # 저해상도에서는 구멍 하나가 큰 지형지물을 가릴 수 있으므로 확률을 신중히 조절
+    hole_prob = cfg.hole_prob_base + \
+                (data > cfg.hole_prob_z_limit).float() * 0.05 + \
+                (edge_map > 1.0).float() * 0.1  # 에지 임계치를 1.0으로 상향
+    
+    m_hole = (torch.rand_like(data) > hole_prob).float()
+    
+    # 최종 결과 및 클리핑
+    output = m_hole * data_noisy
+    return torch.clamp(output, 0.0, 10.0)
+
+
